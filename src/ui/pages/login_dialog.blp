using Gtk 4.0;
using Adw 1;

template $PopcornLoginDialog: Adw.Dialog {
  title: _("Login");
  child: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView navigation_view {
      animate-transitions: true;

      Adw.NavigationPage { /*Welcome Begins*/
        title: _("Welcome");
        tag: "welcome";
        child: Adw.ToolbarView {
          extend-content-to-top-edge: true;

          [top]
          Adw.HeaderBar {
            show-title: false;
          }

          content: Adw.StatusPage {
            icon-name: "com.jeffser.Popcorn";
            title: _("Welcome to Popcorn");
            description: _("Connect to your Jellyfin server");
            child: Gtk.Box {
              spacing: 10;
              orientation: vertical;
              halign: center;
              width-request: 320;

              Adw.EntryRow url_entry {
                styles [
                  "card"
                ]
                title: _("Url");
                entry-activated => $connect_requested();
              }

              Gtk.CheckButton trust_checkbutton {
                label: _("Trust server SSL certificates");
              }

              Gtk.Button {
                styles [
                  "suggested-action",
                  "pill"
                ]
                label: _("Connect");
                tooltip-text: _("Connect");
                halign: center;
                clicked => $connect_requested();
                sensitive: bind $format_to_bool(url_entry.text);
                margin-top: 10;
              }
            };
          };
        };
      } /*Welcome Ends*/

      Adw.NavigationPage { /*Login Begins*/
        title: _("Login");
        tag: "login";
        child: Adw.ToolbarView {
          extend-content-to-top-edge: true;

          [top]
          Adw.HeaderBar {
            show-title: false;
          }

          content: Adw.StatusPage {
            title: _("Sign in to Continue");
            child: Gtk.Box {
              spacing: 20;
              orientation: vertical;
              halign: center;
              width-request: 300;

              Gtk.ListBox {
                styles [
                  "boxed-list"
                ]
                hexpand: true;
                selection-mode: none;
                Adw.EntryRow user_el {
                  title: _("User");
                }
                Adw.PasswordEntryRow password_el {
                  title: _("Password");
                  entry-activated => $login_requested();
                }
              }

              Gtk.Button login_button_el {
                styles [
                  "suggested-action",
                  "pill"
                ]
                label: _("Login");
                tooltip-text: _("Login");
                halign: center;
                clicked => $login_requested();
                sensitive: bind $format_login_sensitivity(user_el.text, password_el.text);
              }

              Gtk.Button quick_connect_button_el {
                styles [
                  "pill"
                ]
                label: _("Use Quick Connect");
                tooltip-text: _("Use Quick Connect");
                halign: center;
                clicked => $quick_connect_requested();
              }

              Gtk.Label {
                styles [
                  "dimmed",
                  "body"
                ]
                label: bind template.disclaimer;
                visible: bind $format_to_bool(template.disclaimer);
                justify: center;
                wrap-mode: word_char;
                wrap: true;
              }
            };
          };
        };
      } /*Login Ends*/

      Adw.NavigationPage {
        title: _("Quick Connect");
        tag: "quick-connect";
        child: Adw.ToolbarView {
          extend-content-to-top-edge: true;

          [top]
          Adw.HeaderBar {
            show-title: false;
          }

          content: Adw.StatusPage {
            title: _("Quick Connect");
            child: Gtk.Box {
              spacing: 10;
              orientation: vertical;
              halign: center;
              width-request: 320;

              Gtk.Label {
                styles [
                  "rounded-corner",
                  "frame",
                  "title-3",
                  "p10"
                ]
                halign: center;
                selectable: true;
                label: bind template.quick-connect-code;
                visible: bind $format_to_bool(template.quick-connect-code);
              }

              Gtk.LinkButton {
                label: _("Login Page");
                uri: bind $format_quick_connect_uri(template.temp-jellyfin as <$PopcornIntegrationJellyfin> .user as <$PopcornServerUser> .server-address);
              }
            };
          };
        };
      }
    };
  };
}