using Gtk 4.0;
using Adw 1;

template $PopcornHomePage: Gtk.ScrolledWindow {
  hexpand: true;
  vexpand: true;
  hscrollbar-policy: never;
  child: Adw.Clamp {
    maximum-size: 2000;
    tightening-threshold: 800;
    child: Gtk.Box {
      styles [
        "p10"
      ]
      orientation: vertical;
      spacing: 10;

      $PopcornOverviewCarousel overview_container {}

      $PopcornCarousel continue_watching_container {
        title: _("Continue Watching");
        icon-name: "playback-symbolic";
        action-name: "app.show_continue_watching";
      }

      $PopcornCarousel next_up_container {
        title: _("Next Up");
        icon-name: "media-playlist-consecutive-symbolic";
        action-name: "app.show_next_up";
      }
    };
  };
}