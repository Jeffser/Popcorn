using Gtk 4.0;
using Adw 1;

template $PopcornHomePage: Adw.NavigationPage {
  title: _("Home");
  tag: "home";
  child: Adw.ToolbarView {
    extend-content-to-top-edge: true;

    [top]
    Adw.HeaderBar {
      show-title: false;
    }

    content: Gtk.ScrolledWindow {
      vexpand: true;
      hexpand: true;
      child: Adw.Clamp {
        maximum-size: 2000;
        tightening-threshold: 800;
        margin-top: 46;
        child: Gtk.Box {
          styles [
            "p10"
          ]
          orientation: vertical;
          spacing: 10;

          Adw.WrapBox user_views_container {
            justify: fill;
            line-spacing: 10;
            child-spacing: 10;
          }
        };
      };
    };
  };
}