using Gtk 4.0;
using Adw 1;

template $PopcornHomePage: Adw.NavigationPage {
  title: _("Home");
  tag: "home";
  child: Adw.ToolbarView {
    extend-content-to-top-edge: true;

    [top]
    Adw.HeaderBar {
      show-title: false;

      [end]
      Gtk.Button {
        styles [
          "circular",
          "search-button-osd"
        ]
        icon-name: "system-search-symbolic";
        action-name: "app.show_search_page";
      }
    }

    content: Gtk.ScrolledWindow {
      vexpand: true;
      hexpand: true;
      hscrollbar-policy: never;
      child: Adw.Clamp {
        maximum-size: 2000;
        tightening-threshold: 800;
        child: Gtk.Box main_container {
          styles [
            "p10"
          ]
          orientation: vertical;
          spacing: 10;

          $PopcornOverviewCarousel overview_container {}

          $PopcornCarousel continue_watching_container {
            title: _("Continue Watching");
            icon-name: "playback-symbolic";
          }

          $PopcornCarousel next_up_container {
            title: _("Next Up");
            icon-name: "media-playlist-consecutive-symbolic";
          }
        };
      };
    };
  };
}