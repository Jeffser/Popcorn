using Gtk 4.0;
using Adw 1;

template $PopcornHomePage: Adw.NavigationPage {
  title: _("Home");
  tag: "home";
  child: Adw.ToolbarView {
    extend-content-to-top-edge: true;

    [top]
    Adw.HeaderBar {
      show-title: false;
    }

    content: Gtk.ScrolledWindow {
      vexpand: true;
      hexpand: true;
      child: Adw.Clamp {
        maximum-size: 2000;
        tightening-threshold: 800;
        child: Gtk.Box {
          styles [
            "p10"
          ]
          orientation: vertical;
          spacing: 10;

          Gtk.Overlay {
            height-request: 480;
            overflow: visible;
            child: Adw.Carousel overview_container {
              styles [
                "card"
              ]
              allow-mouse-drag: true;
              allow-scroll-wheel: false;
            };

            [overlay]
            Adw.Bin {
              styles [
                "blur-backdrop",
                "card"
              ]
              margin-top: 10;
              halign: center;
              valign: start;
              child: Adw.CarouselIndicatorDots {
                margin-end: 5;
                carousel: overview_container;
              };
            }

            [overlay]
            Gtk.Button pan_start_el {
              tooltip-text: _("Pan to the Left");
              icon-name: "pan-start-symbolic";
              valign: center;
              halign: start;
              margin-start: 10;
              clicked => $pan_overview_start();
              styles [
                "circular",
                "flat"
              ]
            }

            [overlay]
            Gtk.Button pan_end_el {
              tooltip-text: _("Pan to the Right");
              icon-name: "pan-end-symbolic";
              valign: center;
              halign: end;
              margin-end: 10;
              clicked => $pan_overview_end();
              styles [
                "circular",
                "flat"
              ]
            }
          }

          Adw.WrapBox user_views_container {
            justify: fill;
            line-spacing: 10;
            child-spacing: 10;
          }

          $PopcornCarousel continue_watching_container {
            title: _("Continue Watching");
            icon-name: "playback-symbolic";
          }

          $PopcornCarousel next_up_container {
            title: _("Next Up");
            icon-name: "media-playlist-consecutive-symbolic";
          }
        };
      };
    };
  };
}