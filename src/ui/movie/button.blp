using Gtk 4.0;
using Adw 1;

template $PopcornMovieButton: Gtk.Button {
  styles [
    "watch_button",
    "flat"
  ]
  valign: end;
  halign: center;
  height-request: bind $format_picture_height(template.is_tall);
  width-request: bind $format_picture_width(template.is_tall);
  tooltip-text: bind template.model as <$PopcornMovie> .Name;
  action-name: "app.show_movie";
  action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
  overflow: hidden;

  Gtk.GestureClick click_gesture {
    button: 3;
    pressed => $on_secondary_click();
  }
  Gtk.GestureLongPress long_press_gesture {
    pressed => $on_long_press();
  }

  child: Gtk.Box {
    orientation: vertical;
    spacing: 5;
    Gtk.Overlay {
      child: Gtk.Picture {
        styles [
          "card"
        ]
        paintable: bind $format_paintable(template.is_tall, template.model as <$PopcornMovie> .BackdropPaintable, template.model as <$PopcornMovie> .PrimaryPaintable);
        content-fit: cover;
        valign: center;
        halign: center;
        vexpand: true;
        accessibility {
          label: _("Movie Poster");
        }
      };

      [overlay]
      Gtk.ToggleButton {
        styles [
          "circular",
          "toggle-with-accent",
          "osd"
        ]
        valign: start;
        halign: end;
        margin-start: 10;
        margin-end: 10;
        margin-top: 10;
        margin-bottom: 10;
        tooltip-text: bind $format_watched_label(template.model as <$PopcornMovie> .Played);
        action-name: "app.toggle_played";
        action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
        active: bind template.model as <$PopcornMovie> .Played;
        icon-name: "check-plain-symbolic";
      }

      [overlay]
      Gtk.Box {
        orientation: vertical;
        spacing: 10;
        margin-start: 10;
        margin-end: 10;
        margin-top: 10;
        margin-bottom: 10;
        valign: end;
        hexpand: true;
        Gtk.Box {
          Gtk.Button {
            styles [
              "osd",
              "circular"
            ]
            tooltip-text: bind $format_play_label(template.model as <$PopcornMovie> .Progress);
            action-name: "app.play_movie";
            action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
            icon-name: "media-playback-start-symbolic";
          }
          Adw.Bin {
            hexpand: true;
          }
          Gtk.ToggleButton {
            styles [
              "circular",
              "toggle-with-accent",
              "osd"
            ]
            tooltip-text: bind $format_heart_label(template.model as <$PopcornMovie> .IsFavorite);
            action-name: "app.toggle_favorite";
            action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
            active: bind template.model as <$PopcornMovie> .IsFavorite;
            icon-name: bind $format_heart_icon_name(template.model as <$PopcornMovie> .IsFavorite);
          }
        }
        Gtk.ProgressBar {
          fraction: bind template.model as <$PopcornMovie> .Progress;
          visible: bind $format_progressbar_visible(template.model as <$PopcornMovie> .Progress);
        }
      }
    }
    Gtk.Label {
      ellipsize: end;
      justify: center;
      label: bind template.model as <$PopcornMovie> .Name;
      max-width-chars: 12;
      styles [
        "title-4"
      ]
    }

    Gtk.Label {
      ellipsize: end;
      justify: center;
      use-markup: true;
      hexpand: true;
      max-width-chars: 12;
      label: bind template.model as <$PopcornMovie> .ProductionYear;
      styles [
        "dimmed"
      ]
    }
  };
}

Gtk.Popover context_popover {
  has-arrow: false;
  halign: start;
  child: Gtk.Box {
    orientation: vertical;
    Gtk.Button {
      styles [
        "flat",
        "no-bold"
      ]
      tooltip-text: bind $format_play_label(template.model as <$PopcornMovie> .Progress);
      child: Adw.ButtonContent {
        halign: start;
        label: bind $format_play_label(template.model as <$PopcornMovie> .Progress);
        icon-name: "media-playback-start-symbolic";
      };
      action-name: "app.play_movie";
      action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
      clicked => $context_popdown();
    }
    Gtk.Button {
      styles [
        "flat",
        "no-bold"
      ]
      tooltip-text: bind $format_watched_label(template.model as <$PopcornMovie> .Played);
      child: Adw.ButtonContent {
        halign: start;
        label: bind $format_watched_label(template.model as <$PopcornMovie> .Played);
        icon-name: "check-plain-symbolic";
      };
      action-name: "app.toggle_played";
      action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
      clicked => $context_popdown();
    }
    Gtk.Button {
      styles [
        "flat",
        "no-bold"
      ]
      tooltip-text: bind $format_heart_label(template.model as <$PopcornMovie> .IsFavorite);
      child: Adw.ButtonContent {
        halign: start;
        label: bind $format_heart_label(template.model as <$PopcornMovie> .IsFavorite);
        icon-name: bind $format_heart_icon_name(template.model as <$PopcornMovie> .IsFavorite);
      };
      action-name: "app.toggle_favorite";
      action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
      clicked => $context_popdown();
    }
  };
}