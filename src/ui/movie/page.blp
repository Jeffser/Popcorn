using Gtk 4.0;
using Adw 1;

template $PopcornMoviePage: Adw.NavigationPage {
  title: bind template.model as <$PopcornMovie> .Name;

  child: Adw.ToolbarView {
    extend-content-to-top-edge: true;

    [top]
    Adw.HeaderBar {
      styles [
        "button-osd"
      ]
      title-widget:
        Adw.WindowTitle {
          styles [
            "text-osd"
          ]
          title: bind template.model as <$PopcornMovie> .Name;
        };
    }

    content: Gtk.ScrolledWindow {
      vexpand: true;
      hexpand: true;
      hscrollbar-policy: never;
      child: Gtk.Box {
        vexpand: true;
        hexpand: true;
        orientation: vertical;
        spacing: 10;

        Adw.Clamp {
          valign: start;
          orientation: vertical;
          maximum-size: 1200;
          tightening-threshold: 2000;
          child: Gtk.Overlay top_overlay {
            hexpand: true;
            child: Gtk.Picture {
              styles [
                "page-background"
              ]
              paintable: bind template.model as <$PopcornMovie> .BackdropPaintable;
              content-fit: cover;
            };

            [overlay]
            Gtk.Box top_overlay_content {
              styles [
                "p10",
                "gradient-background"
              ]
              valign: end;
              hexpand: true;
              orientation: vertical;
              spacing: 10;
              margin-top: 50;

              Adw.Clamp {
                halign: start;
                orientation: vertical;
                maximum-size: 360;
                child: Adw.Clamp {
                  maximum-size: 400;
                  child: Gtk.Stack {
                    height-request: 425;
                    hhomogeneous: false;
                    vhomogeneous: false;
                    visible-child-name: bind $format_stack_visible_child_name(template.model as <$PopcornMovie> .LogoPaintable);
                    Gtk.StackPage {
                      name: "logo";
                      child: Gtk.Picture logo_picture {
                        styles [
                          "logo"
                        ]
                        paintable: bind template.model as <$PopcornMovie> .LogoPaintable;
                        halign: center;
                        valign: end;
                      };
                    }
                    Gtk.StackPage {
                      name: "label";
                      child: Gtk.Label {
                        styles [
                          "title-1"
                        ]
                        ellipsize: end;
                        wrap: true;
                        wrap-mode: word_char;
                        lines: 2;
                        label: bind template.model as <$PopcornMovie> .Name;
                        halign: center;
                        valign: end;
                      };
                    }
                  };
                };
              }

              Adw.WrapBox {
                child-spacing: 10;
                line-spacing: 10;
                halign: start;
                Gtk.ToggleButton {
                  styles [
                    "circular",
                    "flat",
                    "toggle-with-accent",
                    "white"
                  ]
                  valign: center;
                  tooltip-text: _("Toggle Favorite");
                  action-name: "app.toggle_favorite";
                  action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
                  active: bind template.model as <$PopcornMovie> .IsFavorite;
                  icon-name: bind $format_heart_icon_name(template.model as <$PopcornMovie> .IsFavorite);
                }

                Gtk.Button {
                  styles [
                    "pill",
                    "suggested-action"
                  ]
                  tooltip-text: _("Play");
                  action-name: "app.play_movie";
                  action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
                  child: Adw.ButtonContent {
                    icon-name: "media-playback-start-symbolic";
                    label: bind $format_play_button_label(template.model as <$PopcornMovie> .Progress);
                  };
                }
                Gtk.ToggleButton {
                  styles [
                    "circular",
                    "flat",
                    "toggle-with-accent",
                    "white"
                  ]
                  valign: center;
                  tooltip-text: _("Toggle Played");
                  action-name: "app.toggle_played";
                  action-target: bind $format_action_target(template.model as <$PopcornMovie> .Id, 's');
                  active: bind template.model as <$PopcornMovie> .Played;
                  icon-name: "check-plain-symbolic";
                }
              }

              Adw.WrapBox {
                line-spacing: 10;
                child-spacing: 10;
                halign: start;
                Gtk.Box {
                  spacing: 5;
                  visible: bind $format_to_bool(template.model as <$PopcornMovie> .CommunityRating);
                  Gtk.Image {
                    styles [
                      "white"
                    ]
                    icon-name: "starred-symbolic";
                  }
                  Gtk.Label {
                    styles [
                      "numeric",
                      "white"
                    ]
                    label: bind $format_one_decimal(template.model as <$PopcornMovie> .CommunityRating);
                  }
                }

                Gtk.Separator {
                  visible: bind $format_to_bool(template.model as <$PopcornMovie> .CommunityRating);
                }

                Gtk.Label {
                  styles [
                    "numeric",
                    "white"
                  ]
                  label: bind template.model as <$PopcornMovie> .ProductionYear;
                  visible: bind $format_to_bool(template.model as <$PopcornMovie> .ProductionYear);
                }

                Gtk.Separator {
                  visible: bind $format_to_bool(template.model as <$PopcornMovie> .ProductionYear);
                }

                Gtk.Label {
                  styles [
                    "monospace",
                    "white"
                  ]
                  label: bind template.model as <$PopcornMovie> .OfficialRating;
                  visible: bind $format_to_bool(template.model as <$PopcornMovie> .OfficialRating);
                }
              }
              Gtk.Label overview_label {
                styles [
                  "body",
                  "white"
                ]
                wrap-mode: word;
                wrap: true;
                lines: 1;
                xalign: 0;
                label: bind template.model as <$PopcornMovie> .Overview;
              }
            }
          };
        }

        Adw.Clamp {
          maximum-size: 2000;
          tightening-threshold: 800;
          vexpand: true;
          child: Gtk.Box {
            styles [
              "p10"
            ]
            orientation: vertical;
            spacing: 10;

            $PopcornCarousel recommendations_container {
              title: _("Recommendations");
              icon-name: "playback-symbolic";
            }
          };
        }
      };
    };
  };
}