using Gtk 4.0;
using Adw 1;

template $PopcornPlayerPage: Adw.NavigationPage {
  styles [
    "black-background"
  ]
  title: _("Player");

  Gtk.EventControllerMotion {
    motion => $on_pointer_motion();
  }

  child: Adw.ToolbarView toolbarview {
    extend-content-to-top-edge: true;
    reveal-top-bars: false;

    [top]
    Adw.HeaderBar {
      styles [
        "osd"
      ]
      title-widget: Adw.WindowTitle {
        title: bind template.player as <$PopcornPlayer> .model as <$PopcornPlayable> .PlayerTitle;
        subtitle: bind template.player as <$PopcornPlayer> .model as <$PopcornPlayable> .PlayerSubtitle;
      };

      [end]
      Gtk.Button {
        tooltip-text: _("Watch in Picture-in-Picture");
        icon-name: "pip-in-symbolic";
        visible: bind $format_pip_button_visible(template.root as <Gtk.Window> .title);
        clicked => $open_pip_window();
      }
    }

    content: Gtk.Overlay {
      child: Gtk.Picture {
        paintable: bind template.player as <$PopcornPlayer> .paintable;
      };

      [overlay]
      Adw.Clamp {
        maximum-size: 1200;
        child: Gtk.Box {
          orientation: vertical;
          margin-top: 10;
          margin-start: 10;
          margin-end: 10;
          valign: end;
          hexpand: true;

          Gtk.Revealer skip_segment_revealer {
            transition-duration: 250;
            transition-type: crossfade;
            reveal-child: bind $format_to_bool(template.current-media-segment as <$PopcornMediaSegment> .Id);
            halign: end;
            child: Gtk.Button skip_segment_button {
              styles [
                "suggested-action",
                "pill"
              ]
              margin-bottom: 10;
              clicked => $skip_segment_clicked();
              tooltip-text: bind $format_segment_skipper_label(template.current-media-segment as <$PopcornMediaSegment> .Type);
              child: Adw.ButtonContent {
                label: bind $format_segment_skipper_label(template.current-media-segment as <$PopcornMediaSegment> .Type);
                icon-name: "media-seek-forward-symbolic";
              };
            };
          }

          Gtk.Revealer controls_revealer {
            transition-duration: 250;
            transition-type: slide_up;
            child: Gtk.Box {
              styles [
                "osd",
                "player-controls-container"
              ]
              orientation: vertical;
              spacing: 5;
              margin-bottom: 10;

              Gtk.Box {
                orientation: horizontal;
                spacing: 5;

                Gtk.Button {
                  styles [
                    "circular",
                    "flat"
                  ]
                  tooltip-text: _("Previous");
                  icon-name: "media-skip-backward-symbolic";
                  sensitive: bind $format_to_bool(template.player as <$PopcornPlayer> .previous_model);
                  clicked => $previous_clicked();
                }

                Gtk.Stack {
                  transition-type: crossfade;
                  visible-child-name: bind $format_visible_state_button(template.player as <$PopcornPlayer> .gst-state);
                  Gtk.StackPage {
                    name: "pause";
                    child: Gtk.Button {
                      styles [
                        "circular",
                        "flat"
                      ]
                      tooltip-text: _("Pause");
                      icon-name: "media-playback-pause-symbolic";
                      clicked => $pause_clicked();
                    };
                  }
                  Gtk.StackPage {
                    name: "play";
                    child: Gtk.Button {
                      styles [
                        "circular",
                        "flat"
                      ]
                      tooltip-text: _("Play");
                      icon-name: "media-playback-start-symbolic";
                      clicked => $play_clicked();
                    };
                  }
                }

                Gtk.Button {
                  styles [
                    "circular",
                    "flat"
                  ]
                  tooltip-text: _("Next");
                  icon-name: "media-skip-forward-symbolic";
                  sensitive: bind $format_to_bool(template.player as <$PopcornPlayer> .next_model);
                  clicked => $next_clicked();
                }

                Gtk.Label {
                  label: bind template.end-time;
                  xalign: 0;
                  ellipsize: middle;
                }

                Adw.Bin {
                  hexpand: true;
                }

                Gtk.MenuButton volume_menubutton {
                  styles [
                    "flat"
                  ]
                  icon-name: bind $format_volume_icon_name(volume_adjustment.value);
                  popover: Gtk.Popover {
                    child: Gtk.Box {
                      orientation: horizontal;

                      Gtk.Button {
                        styles [
                          "flat"
                        ]
                        icon-name: "speaker-0-symbolic";
                        tooltip-text: _("Mute");
                        clicked => $mute_volume_clicked();
                      }

                      Gtk.Scale {
                        adjustment: Gtk.Adjustment volume_adjustment {
                          lower: 0;
                          upper: 1;
                          value: 0.25;
                        };
                        width-request: 150;
                      }

                      Gtk.Button {
                        styles [
                          "flat"
                        ]
                        icon-name: "speaker-3-symbolic";
                        tooltip-text: _("Full Volume");
                        clicked => $full_volume_clicked();
                      }
                    };
                  };
                }

                Gtk.ToggleButton {
                  styles [
                    "flat"
                  ]
                  icon-name: "view-fullscreen-symbolic";
                  active: bind template.root as <Gtk.Window> .fullscreened;
                  notify::active => $fullscreen_toggled();
                }
              }

              Gtk.Box {
                orientation: horizontal;
                spacing: 5;

                Gtk.Label {
                  styles [
                    "numeric"
                  ]
                  label: bind $format_time_ellapsed(template.position, template.player as <$PopcornPlayer> .model as <$PopcornPlayable> .Duration);
                }

                Gtk.Scale scale {
                  Gtk.GestureClick {
                      pressed => $scale_pressed();
                      unpaired-release => $scale_released();
                  }
                  hexpand: true;
                  value-changed => $adjustment_changed();
                  adjustment: Gtk.Adjustment {
                    lower: 0;
                    upper: bind template.player as <$PopcornPlayer> .model as <$PopcornPlayable> .Duration;
                    value: bind template.position;
                  };
                }

                Gtk.Label {
                  styles [
                    "numeric"
                  ]
                  label: bind $format_time_remaining(template.position, template.player as <$PopcornPlayer> .model as <$PopcornPlayable> .Duration);
                }
              }
            };
          }
        };
      }
    };
  };
}