using Gtk 4.0;
using Adw 1;

template $PopcornPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";
    Adw.PreferencesGroup {
      title: _("Appearance");
      Adw.ComboRow content_fit_el {
        title: _("Player Content Fit Mode");
        subtitle: _("Only applies when in fullscreen mode");
        model: Gtk.StringList {
          strings [
            _("Fill"),
            _("Contain (Default)"),
            _("Cover"),
            _("Scale Down")
          ]
        };
      }

      Adw.ActionRow {
        title: _("Default Button Action");
        subtitle: _("Action to perform when clicking a media button");
        [suffix]
        Adw.ToggleGroup default_button_action_el {
          valign: center;
          Adw.Toggle {
            name: "open";
            label: _("Open");
            tooltip: _("Open");
          }
          Adw.Toggle {
            name: "play";
            label: _("Play");
            tooltip: _("Play");
          }
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Gnome Search");
      description: _("Search for your media directly from the system search bar while Popcorn is running. You can enable or disable this feature completely in System Settings");
      visible: bind template.is-gnome;

      Adw.SwitchRow gnome_search_movie_el {
        title: _("Include Movies");
      }
      Adw.SwitchRow gnome_search_series_el {
        title: _("Include Series");
      }
      Adw.SwitchRow gnome_search_episode_el {
        title: _("Include Episodes");
      }
    }

    Adw.PreferencesGroup {
      title: _("Session");
      visible: bind $format_to_bool(template.session-server-name);

      Adw.ActionRow {
        title: bind template.session-username;
        subtitle: bind template.session-server-name;
        action-name: "app.open_uri";
        action-target: bind $format_action_target(template.session-url, 's');
        activatable: bind $format_to_bool(template.session-url);
        tooltip-text: bind template.session-url;

        [prefix]
        Adw.Avatar {
          size: 32;
          custom-image: bind template.session-user-paintable;
        }

        [suffix]
        Gtk.Image {
          icon-name: "external-link-symbolic";
          visible: bind $format_to_bool(template.session-url);
        }
      }

      Adw.ButtonRow {
        title: _("Change User");
        action-name: "app.change_user";
      }
    }
  }
}