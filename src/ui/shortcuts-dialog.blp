using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");
    Adw.ShortcutsItem {
      title: _("Search");
      subtitle: _("Not available while a video is playing in the main window");
      action-name: "app.show_search_page";
    }
  }
  Adw.ShortcutsSection {
    title: _("Player");
    Adw.ShortcutsItem {
      title: _("Toggle Playback");
      accelerator: "space";
    }
    Adw.ShortcutsItem {
      title: _("Seek Forward");
      accelerator: "Right";
    }
    Adw.ShortcutsItem {
      title: _("Seek Backward");
      accelerator: "Left";
    }
    Adw.ShortcutsItem {
      title: _("Raise Volume");
      accelerator: "Up";
    }
    Adw.ShortcutsItem {
      title: _("Lower Volume");
      accelerator: "Down";
    }
  }
}