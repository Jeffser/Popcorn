using Gtk 4.0;

template $PopcornSeasonButton: Gtk.Box {
  styles [
    "watch_button"
  ]
  halign: center;
  orientation: vertical;
  spacing: 5;

  Gtk.Overlay {
    child: Gtk.Button {
      styles [
        "force_p0",
        "card"
      ]
      overflow: hidden;
      tooltip-text: bind template.model as <$PopcornSeason> .Name;
      action-name: "app.show_season";
      action-target: bind $format_action_target(template.model as <$PopcornSeason> .Id, 's');
      child: Gtk.Picture {
        content-fit: cover;
        paintable: bind template.model as <$PopcornSeason> .PrimaryPaintable;
        height-request: 360;
        width-request: 220;
      };
    };

    [overlay]
    Gtk.ToggleButton {
      styles [
        "circular",
        "toggle-with-accent",
        "osd"
      ]
      valign: start;
      halign: end;
      margin-start: 10;
      margin-end: 10;
      margin-top: 10;
      margin-bottom: 10;
      tooltip-text: _("Toggle Played");
      action-name: "app.toggle_played";
      action-target: bind $format_action_target(template.model as <$PopcornSeason> .Id, 's');
      active: bind template.model as <$PopcornSeason> .Played;
      icon-name: "checkmark-symbolic";
    }

    [overlay]
    Gtk.Button {
      styles [
        "osd",
        "circular"
      ]
      tooltip-text: _("Play Season");
      action-name: "app.play_season";
      action-target: bind $format_action_target(template.model as <$PopcornSeason> .Id, 's');
      icon-name: "media-playback-start-symbolic";
      valign: end;
      halign: start;
      margin-start: 10;
      margin-end: 10;
      margin-top: 10;
      margin-bottom: 10;
    }
  }

  Gtk.Button {
    styles [
      "flat",
      "p0"
    ]
    tooltip-text: bind template.model as <$PopcornSeason> .Name;
    action-name: "app.show_season";
    action-target: bind $format_action_target(template.model as <$PopcornSeason> .Id, 's');
    child: Gtk.Label {
      ellipsize: end;
      justify: center;
      label: bind template.model as <$PopcornSeason> .Name;
      max-width-chars: 12;
      styles [
        "title-4"
      ]
    };
  }
}