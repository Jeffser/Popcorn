using Gtk 4.0;
using Adw 1;

template $PopcornOverviewCarousel: Gtk.Overlay {
  overflow: visible;
  child: Adw.Carousel list_el {
    styles [
      "card"
    ]
    allow-mouse-drag: true;
    allow-scroll-wheel: false;
    height-request: 580;

    Gtk.EventControllerScroll {
      scroll => $on_scroll();
      flags: both_axes;
    }

    Adw.Spinner {
      width-request: 32;
      height-request: 32;
    }
  };

  [overlay]
  Gtk.Button pan_start_button {
    tooltip-text: _("Pan");
    icon-name: "pan-start-symbolic";
    valign: center;
    halign: start;
    margin-start: 10;
    visible: bind $format_visible_button(list_el.n-pages);
    clicked => $pan_start();
    styles [
      "circular",
      "osd"
    ]
  }

  [overlay]
  Gtk.Button pan_end_button {
    tooltip-text: _("Pan");
    icon-name: "pan-end-symbolic";
    valign: center;
    halign: end;
    margin-end: 10;
    visible: bind $format_visible_button(list_el.n-pages);
    clicked => $pan_end();
    styles [
      "circular",
      "osd"
    ]
  }

}