using Gtk 4.0;

template $PopcornSeriesButton: Gtk.Box {
  styles [
    "watch_button"
  ]
  orientation: vertical;
  spacing: 5;

  Gtk.Button {
    styles [
      "force_p0",
      "card"
    ]
    overflow: hidden;
    tooltip-text: bind template.model as <$PopcornSeries> .Name;
    action-name: "app.show_series";
    action-target: bind $format_action_target(template.model as <$PopcornSeries> .Id, 's');
    child: Gtk.Overlay {
      child: Gtk.Picture {
        content-fit: cover;
        paintable: bind $format_paintable(template.is_tall, template.model as <$PopcornSeries> .BackdropPaintable, template.model as <$PopcornSeries> .PrimaryPaintable);
        height-request: bind $format_paintable_height(template.is_tall);
      };

      [overlay]
      Gtk.Button {
        styles [
          "osd",
          "circular"
        ]
        tooltip-text: _("Play Series");
        icon-name: "media-playback-start-symbolic";
        valign: end;
        halign: start;
        margin-start: 10;
        margin-end: 10;
        margin-top: 10;
        margin-bottom: 10;
      }
    };
  }

  Gtk.Button {
    styles [
      "flat",
      "p0"
    ]
    tooltip-text: bind template.model as <$PopcornSeries> .Name;
    action-name: "app.show_series";
    action-target: bind $format_action_target(template.model as <$PopcornSeries> .Id, 's');
    child: Gtk.Box {
      orientation: vertical;
      spacing: 5;
      Gtk.Label {
        ellipsize: end;
        justify: center;
        label: bind template.model as <$PopcornSeries> .Name;
        max-width-chars: 12;
        styles [
          "title-4"
        ]
      }

      Gtk.Label {
        ellipsize: end;
        justify: center;
        use-markup: true;
        hexpand: true;
        max-width-chars: 12;
        label: bind template.model as <$PopcornSeries> .ProductionYear;
        styles [
          "dimmed"
        ]
      }
    };
  }
}