using Gtk 4.0;

template $PopcornSeriesButton: Gtk.Button {
  styles [
    "watch_button",
    "flat"
  ]
  valign: center;
  halign: center;
  height-request: bind $format_picture_height(template.is_tall);
  width-request: bind $format_picture_width(template.is_tall);
  tooltip-text: bind template.model as <$PopcornSeries> .Name;
  action-name: "app.show_series";
  action-target: bind $format_action_target(template.model as <$PopcornSeries> .Id, 's');
  overflow: hidden;

  Gtk.GestureClick click_gesture {
    button: 3;
    pressed => $on_secondary_click();
  }
  Gtk.GestureLongPress long_press_gesture {
    pressed => $on_long_press();
  }

  child: Gtk.Box {
    orientation: vertical;
    spacing: 5;
    Gtk.Overlay {
      child: Gtk.Picture {
        styles [
          "card"
        ]
        paintable: bind $format_paintable(template.is_tall, template.model as <$PopcornSeries> .BackdropPaintable, template.model as <$PopcornSeries> .PrimaryPaintable);
        content-fit: cover;
        valign: center;
        halign: center;
        vexpand: true;
        accessibility {
          label: _("Series Poster");
        }
      };

      [overlay]
      Gtk.ToggleButton {
        styles [
          "circular",
          "toggle-with-accent",
          "osd"
        ]
        valign: start;
        halign: end;
        margin-start: 10;
        margin-end: 10;
        margin-top: 10;
        margin-bottom: 10;
        tooltip-text: _("Toggle Played");
        action-name: "app.toggle_played";
        action-target: bind $format_action_target(template.model as <$PopcornSeries> .Id, 's');
        active: bind template.model as <$PopcornSeries> .Played;
        icon-name: "check-plain-symbolic";
      }

      [overlay]
      Gtk.ToggleButton {
        styles [
          "circular",
          "toggle-with-accent",
          "osd"
        ]
        valign: end;
        halign: end;
        margin-start: 10;
        margin-end: 10;
        margin-top: 10;
        margin-bottom: 10;
        tooltip-text: _("Toggle Favorite");
        action-name: "app.toggle_favorite";
        action-target: bind $format_action_target(template.model as <$PopcornSeries> .Id, 's');
        active: bind template.model as <$PopcornSeries> .IsFavorite;
        icon-name: bind $format_heart_icon_name(template.model as <$PopcornSeries> .IsFavorite);
      }

      [overlay]
      Gtk.Button {
        styles [
          "osd",
          "circular"
        ]
        tooltip-text: _("Play Series");
        action-name: "app.play_series";
        action-target: bind $format_action_target(template.model as <$PopcornSeries> .Id, 's');
        icon-name: "media-playback-start-symbolic";
        valign: end;
        halign: start;
        margin-start: 10;
        margin-end: 10;
        margin-top: 10;
        margin-bottom: 10;
      }
    }

    Gtk.Label {
      ellipsize: end;
      justify: center;
      label: bind template.model as <$PopcornSeries> .Name;
      max-width-chars: 12;
      styles [
        "title-4"
      ]
    }

    Gtk.Label {
      ellipsize: end;
      justify: center;
      use-markup: true;
      hexpand: true;
      max-width-chars: 12;
      label: bind template.model as <$PopcornSeries> .ProductionYear;
      styles [
        "dimmed"
      ]
    }
  };
}