<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.jeffser.Popcorn</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Popcorn</name>
  <summary>Explore Jellyfin with style</summary>
  <description>
    <p>A modern Jellyfin client</p>
    <p>Features</p>
    <ul>
      <li>Dedicated pages for all types of elements</li>
      <li>VTT subtitle support</li>
      <li>Player gestures</li>
      <li>Picture-in-Picture playback</li>
      <li>Trickplay (scrobbing thumbnails)</li>
      <li>Intro / Outro skipper</li>
      <li>Cool interface</li>
    </ul>
  </description>

  <developer id="com.jeffser">
    <name>Jeffry Samuel Eduarte Rojas</name>
  </developer>

  <provides>
    <binary>popcorn</binary>
  </provides>
  <icon type="stock">com.jeffser.Popcorn</icon>
  <categories>
    <category>AudioVideo</category>
  </categories>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <url type="homepage">https://jeffser.com/popcorn</url>
  <url type="vcs-browser">https://github.com/Jeffser/Popcorn</url>
  <url type="bugtracker">https://github.com/Jeffser/Popcorn/issues</url>
  <url type="help">https://github.com/Jeffser/Popcorn/discussions</url>
  <url type="donation">https://github.com/sponsors/Jeffser</url>
  <url type="contribute">https://github.com/Jeffser/Popcorn/blob/main/CONTRIBUTING.md</url>

  <translation type="gettext">popcorn</translation>
  <launchable type="desktop-id">com.jeffser.Popcorn.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#ffbe6f</color>
    <color type="primary" scheme_preference="dark">#a51d2d</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://jeffser.com/images/popcorn/screenie1.png</image>
      <caption>Main homepage</caption>
    </screenshot>
    <screenshot>
      <image>https://jeffser.com/images/popcorn/screenie2.png</image>
      <caption>A series page</caption>
    </screenshot>
    <screenshot>
      <image>https://jeffser.com/images/popcorn/screenie3.png</image>
      <caption>A movie page</caption>
    </screenshot>
    <screenshot>
      <image>https://jeffser.com/images/popcorn/screenie4.png</image>
      <caption>A stream playing</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-09-29">
      <url type="details">https://github.com/Jeffser/Popcorn/releases/tag/0.1.0</url>
      <description translate="no">
        <p>Initial public release of Popcorn</p>
      </description>
    </release>
  </releases>

</component>
