<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="popcorn">
	<schema id="com.jeffser.Popcorn" path="/com/jeffser/Popcorn/">
	  <key name="default-user-id" type="s">
	    <default>''</default>
	  </key>
	  <key name="volume" type="d">
	    <default>0.25</default>
	  </key>

	  <!-- # Preferences -->
	  <!-- ## General -->
	  <key name="fullscreen-content-fit" type="i">
	    <default>1</default>
	  </key>
	  <key name="default-model-action" type="s">
	    <default>'open'</default>
	  </key>

	  <!-- ## Gnome Search -->
	  <key name="gnome-search-include-movie" type="b">
	    <default>true</default>
	  </key>
	  <key name="gnome-search-include-series" type="b">
	    <default>true</default>
	  </key>
	  <key name="gnome-search-include-episode" type="b">
	    <default>false</default>
	  </key>
	</schema>
</schemalist>



