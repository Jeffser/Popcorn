<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="popcorn">
	<schema id="com.jeffser.Popcorn" path="/com/jeffser/Popcorn/">
    <key name="url" type="s">
      <default>'http://127.0.0.1:8096'</default>
    </key>
    <key name="user" type="s">
      <default>''</default>
    </key>
    <key name="trust-server" type="b">
      <default>false</default>
    </key>
	  <key name="volume" type="d">
	    <default>0.25</default>
	  </key>

	  <!-- # Preferences -->
	  <!-- ## General -->
	  <key name="blur-effect" type="b">
	    <default>true</default>
	  </key>
	  <key name="fullscreen-content-fit" type="i">
	    <default>1</default>
	  </key>

	  <!-- ## Gnome Search -->
	  <key name="gnome-search-include-movie" type="b">
	    <default>true</default>
	  </key>
	  <key name="gnome-search-include-series" type="b">
	    <default>true</default>
	  </key>
	  <key name="gnome-search-include-episode" type="b">
	    <default>false</default>
	  </key>
	</schema>
</schemalist>


